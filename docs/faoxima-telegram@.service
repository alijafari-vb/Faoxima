[Unit]
Description=Faoxima Telegram %i
After=network.target

[Service]
Type=simple
User=FAOXIMA_USER
WorkingDirectory=/path/to/faoxima
# Uncomment for a Rebecca External App using local HTTPS.
# Environment=FAOXIMA_REBECCA_MODE=1
ExecStart=/usr/bin/php /path/to/faoxima/scripts/telegram-polling.php %i
Restart=always
RestartSec=3s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
